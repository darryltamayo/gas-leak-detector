# Application Configuration
APP_NAME="Smart AC Outlet Controller"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u907280979_docrequest
DB_USER=u907280979_darryl
DB_PASS=your_database_password_here

# Session Configuration
SESSION_LIFETIME=7200
SESSION_NAME=IOT_OUTLET_SESSION

# Security
API_KEY=your-secure-api-key-here-change-in-production
CSRF_TOKEN_LENGTH=32

# Email Configuration (Optional)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Timezone
APP_TIMEZONE=UTC

# ESP32 Configuration
ESP32_HEARTBEAT_TIMEOUT=120

# Logging
LOG_LEVEL=debug
LOG_PATH=../storage/logs/
